name: Release pull request

on:
  pull_request:
    types: [opened, reopened, synchronize, closed]
    branches: [main]

permissions:
  contents: write
  actions: write

concurrency:
  group: release-{% raw %}${{ github.event.pull_request.number }}{% endraw %}
  cancel-in-progress: false

jobs:
  release:
    if: {% raw %}${{ startsWith(github.event.pull_request.head.ref, 'release/') && github.event.pull_request.head.repo.full_name == github.repository && (github.event.action != 'closed' || github.event.pull_request.merged == true) }}{% endraw %}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7.0.1
        with:
          ref: {% raw %}${{ github.event.pull_request.merged && github.event.pull_request.merge_commit_sha || github.event.pull_request.head.sha }}{% endraw %}
      - uses: astral-sh/setup-uv@v10.3.2

      - name: Prepare draft or publish the integrated release
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
          RELEASE_BRANCH: {% raw %}${{ github.event.pull_request.head.ref }}{% endraw %}
          MERGED: {% raw %}${{ github.event.pull_request.merged }}{% endraw %}
        run: |
          version="$(uv version --short)"
          if [ "$RELEASE_BRANCH" != "release/$version" ]; then
            echo "Release branch must match package version $version" >&2
            exit 1
          fi
          target="$(git rev-parse HEAD)"
          tag_refs="$(git ls-remote origin "refs/tags/$version" "refs/tags/$version^{}")"
          tag_target="$(printf '%s\n' "$tag_refs" | awk '$2 ~ /\^\{\}$/ { print $1; peeled = 1; exit } { direct = $1 } END { if (!peeled && direct != "") print direct }')"
          if [ -n "$tag_target" ] && [ "$tag_target" != "$target" ]; then
            echo "Tag $version points to $tag_target, not integrated commit $target" >&2
            exit 1
          fi
          if is_draft=$(gh release view "$version" --json isDraft --jq .isDraft); then
            if [ "$is_draft" = false ]; then
              if [ "$MERGED" != true ] || [ "$tag_target" != "$target" ]; then
                echo "Release $version is already published" >&2
                exit 1
              fi
            elif [ "$MERGED" = true ]; then
              gh release edit "$version" --target "$target" --draft=false
            else
              gh release edit "$version" --target "$target"
            fi
          elif [ "$MERGED" = true ]; then
            echo "Draft release $version is missing; prepare and review it before merging" >&2
            exit 1
          else
            gh release create "$version" --draft --generate-notes --target "$target"
          fi
          if [ "$MERGED" = true ]; then
            gh workflow run cd.yml --ref "$version" -f publish=true
          fi

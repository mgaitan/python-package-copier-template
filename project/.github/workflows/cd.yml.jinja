name: Publish to PyPI

on:
  release:
    types: [published]
  push:
    branches:
      - main
    paths:
      - "docs/**"
      - "README.md"
      - "CONTRIBUTING.md"
      - ".github/workflows/cd.yml"
  pull_request:
    branches:
      - main
    paths:
      - "docs/**"
      - "README.md"
      - "CONTRIBUTING.md"
      - ".github/workflows/cd.yml"
  workflow_dispatch:
    inputs:
      publish:
        description: Publish the selected released tag to PyPI
        type: boolean
        default: false

permissions:
  contents: read
  pages: write
  id-token: write

env:
  UV_MALWARE_CHECK: "1"

jobs:
  pypi-publish:
    name: upload release to PyPI
    runs-on: ubuntu-latest
    if: github.event_name == 'release' || (github.event_name == 'workflow_dispatch' && inputs.publish)
    permissions:
      id-token: write
      contents: read
    steps:
      - uses: actions/checkout@v7.0.1
      - uses: astral-sh/setup-uv@v10.3.0

      - name: Verify published release tag
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          test "$GITHUB_REF_TYPE" = tag
          test "${GITHUB_REF_NAME#v}" = "$(uv version --short)"
          test "$(gh release view "$GITHUB_REF_NAME" --json isDraft --jq .isDraft)" = false
          git fetch origin main
          git merge-base --is-ancestor HEAD origin/main

      - run: uv build

      - name: Smoke test built wheel in isolation
        run: |
          wheel=$(find dist -name '*.whl' -print -quit)
          test -n "$wheel"
          uv run --isolated --no-project --with "$wheel" python -c "import {{ python_package_import_name }}"

      - name: Generate PEP 740 publish attestations
        uses: astral-sh/attest-action@f589a42a7efb6fe400b4f400de60b4bc90390027 # v0.0.6

      - run: uv publish

  docs-publish:
    name: Publish documentation to GitHub Pages
    runs-on: ubuntu-latest
    if: inputs.publish != true && github.event_name != 'release' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)
    environment:
      name: {% raw %}${{ github.event_name == 'pull_request' && 'github-pages-preview' || 'github-pages' }}{% endraw %}
      url: {% raw %}${{ steps.preview_url.outputs.url }}{% endraw %}
    steps:
      - uses: actions/checkout@v7.0.1
      - name: Detect documentation preview target
        id: preview
        run: |
          if [ "{% raw %}${{ github.event_name }}{% endraw %}" = "pull_request" ]; then
            echo "docs_subdir=_preview/pr-{% raw %}${{ github.event.pull_request.number }}{% endraw %}" >> "$GITHUB_OUTPUT"
          fi
      - uses: actions/configure-pages@v6.0.0
      - uses: astral-sh/setup-uv@v10.3.0
      - run: make docs
      - name: Stage documentation artifact
        run: |
          out_dir="site"
          subdir="{% raw %}${{ steps.preview.outputs.docs_subdir }}{% endraw %}"
          rm -rf "$out_dir"
          if [ -n "$subdir" ]; then
            mkdir -p "$out_dir/$subdir"
            cp -a docs/_build/html/. "$out_dir/$subdir/"
          else
            mkdir -p "$out_dir"
            cp -a docs/_build/html/. "$out_dir/"
          fi
      - uses: actions/upload-pages-artifact@v5.0.0
        with:
          path: site
      - id: deployment
        uses: actions/deploy-pages@v5.0.1
      - name: Compute documentation URL
        id: preview_url
        run: |
          url="{% raw %}${{ steps.deployment.outputs.page_url }}{% endraw %}"
          subdir="{% raw %}${{ steps.preview.outputs.docs_subdir }}{% endraw %}"
          if [ -n "$subdir" ]; then
            url="${url%/}/${subdir}"
          fi
          echo "url=${url}" >> "$GITHUB_OUTPUT"
      - name: Summarize documentation URL
        run: |
          echo "Documentation published at: {% raw %}${{ steps.preview_url.outputs.url }}{% endraw %}" >> "$GITHUB_STEP_SUMMARY"
